{
  "schemaVersion": 1,
  "id": "laurent22/joplin-server-basic",
  "kind": "compose",
  "name": "Joplin Server + PostgreSQL 基础版",
  "description": "为 Joplin 客户端提供笔记同步与共享服务，数据保存在配套 PostgreSQL 中。服务端源码可查看，个人用途与商业用途适用不同授权。",
  "developer": "Joplin",
  "projectUrl": "https://github.com/laurent22/joplin",
  "source": "unknown",
  "license": "Joplin Server Personal Use License / commercial license",
  "paidKey": "optional",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "joplin",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/basic-joplin.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/laurent22/joplin/blob/dev/packages/server/README.md",
  "recommendations": [
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "为当前新实例设置独立密码；数据库仅供项目内服务连接。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.APP_BASE_URL",
      "title": "实际访问地址",
      "reason": "必须与浏览器和客户端使用的地址一致；使用服务器 IP 或正式域名，修改端口时同步修改此处。",
      "required": true,
      "example": "https://notes.example.com"
    },
    {
      "target": "compose.services.app",
      "title": "首次登录",
      "reason": "默认管理员为 admin@localhost / admin；首次登录后修改管理员资料，并新建用于同步的用户。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "joplin",
      "name": "Joplin Server",
      "developer": "Joplin",
      "projectUrl": "https://github.com/laurent22/joplin",
      "icon": "icons/basic-joplin.svg",
      "services": [
        "app"
      ]
    },
    {
      "id": "postgresql",
      "name": "PostgreSQL",
      "developer": "PostgreSQL Global Development Group",
      "projectUrl": "https://www.postgresql.org/",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "db"
      ]
    }
  ],
