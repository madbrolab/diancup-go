{
  "schemaVersion": 1,
  "id": "karakeep-app/karakeep",
  "kind": "compose",
  "name": "Karakeep",
  "description": "把网页、图片和笔记集中收藏，保存内容快照并全文检索，适合整理个人长期阅读资料；可按需连接模型服务辅助打标签。",
  "developer": "karakeep-app",
  "projectUrl": "https://github.com/karakeep-app/karakeep",
  "source": "open",
  "license": "AGPL-3.0",
  "paidKey": "optional",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "karakeep",
    "收藏",
    "网页归档",
    "书签"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/karakeep.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.karakeep.com/installation/docker/",
  "applications": [
    {
      "id": "karakeep",
      "name": "Karakeep",
      "developer": "karakeep-app",
      "projectUrl": "https://github.com/karakeep-app/karakeep",
      "icon": "icons/karakeep.svg",
      "services": [
        "web",
        "chrome"
      ]
    },
    {
      "id": "search",
      "name": "Meilisearch",
      "developer": "Meilisearch",
      "projectUrl": "https://github.com/meilisearch/meilisearch",
      "icon": "icons/infra-meilisearch.svg",
      "services": [
        "meilisearch"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.NEXTAUTH_URL",
      "title": "实际访问地址",
      "reason": "填写浏览器实际使用的完整地址，端口与 HTTP_PORT 或反向代理一致。首次访问注册自己的账号。",
      "required": true,
      "example": "http://nas.example.com:3000"
    },
    {
      "target": "env.NEXTAUTH_SECRET",
      "title": "会话密钥",
      "reason": "填写独立的长随机字符串并长期保留。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.MEILI_MASTER_KEY",
      "title": "搜索服务密钥",
      "reason": "填写至少 32 字符的独立随机值，应用与搜索服务共用此值。",
      "required": true,
      "example": ""
    },
    {
      "target": "compose.services.web.volumes",
      "title": "收藏与搜索数据",
      "reason": "./data 保存资料与附件，./search-data 保存搜索数据。浏览器和搜索端口只在项目网络中访问。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.web.environment",
      "title": "可选功能与费用",
      "reason": "基础收藏与检索可直接自建。README 另列收费托管订阅；AI 标签需自行接入模型，外部服务费用由对应服务商决定。",
      "required": false,
      "example": ""
    }
  ],
