{
  "schemaVersion": 1,
  "id": "gitea/gitea-postgresql",
  "kind": "compose",
  "name": "Gitea + PostgreSQL",
  "description": "轻量 Git 托管平台，搭配 PostgreSQL 数据库。",
  "developer": "Gitea",
  "projectUrl": "https://github.com/go-gitea/gitea",
  "source": "open",
  "license": "MIT",
  "paidKey": "none",
  "version": "1.1.1",
  "category": "development",
  "tags": [
    "gitea",
    "git",
    "postgresql",
    "代码托管"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/gitea-postgresql.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "recommendations": [
    {
      "target": "env.WEB_PORT",
      "title": "网页端口",
      "reason": "确认宿主机端口可用。",
      "required": true,
      "example": "3000"
    },
    {
      "target": "env.SSH_PORT",
      "title": "Git SSH 端口",
      "reason": "避免与宿主机 SSH 端口冲突。",
      "required": true,
      "example": "2222"
    },
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "填写独立强密码。",
      "required": true,
      "example": ""
    }
  ],
  "documentation": "https://docs.gitea.com/installation/install-with-docker/",
  "applications": [
    {
      "id": "gitea",
      "name": "Gitea",
      "icon": "icons/gitea.svg",
      "developer": "Gitea",
      "projectUrl": "https://github.com/go-gitea/gitea",
      "services": [
        "gitea"
      ]
    },
    {
      "id": "postgresql",
      "name": "PostgreSQL",
      "icon": "icons/postgresql.svg",
      "developer": "PostgreSQL",
      "projectUrl": "https://github.com/postgres/postgres",
      "services": [
        "db"
      ]
    }
  ],
  "verification": {
    "checkedAt": "2026-11-05",
    "lastCommitAt": "2026-11-04T05:51:12Z",
    "lastCommit": "ab295e62e4c708d87600efa77fca44195bacfa17",
    "readmeSHA256": "596511a44a8451c5ee3e38547ff19d8d23b8f7f80843ccebee15405b8c898497",
    "readmeURL": "https://github.com/go-gitea/gitea/blob/main/README.md"
  }
}
