{
  "schemaVersion": 1,
  "id": "navidrome/navidrome-basic",
  "kind": "compose",
  "name": "Navidrome 基础版",
  "description": "把本地音乐目录整理为可在浏览器和 Subsonic 客户端访问的个人曲库，支持用户、歌单与播放记录。模板默认每小时扫描一次。",
  "developer": "Navidrome",
  "projectUrl": "https://github.com/navidrome/navidrome",
  "source": "open",
  "license": "GPL-3.0",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "media",
  "tags": [
    "navidrome",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/navidrome.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/navidrome/navidrome/blob/7c1e68a1e4e68e7257affba4f25cd9cb545c7016/README.md",
  "recommendations": [
    {
      "target": "env.MUSIC_DIR",
      "title": "音乐目录",
      "reason": "默认 ./music，请选择实际音乐目录，容器内只读。",
      "required": false,
      "example": ""
    },
    {
      "target": "env.SCAN_SCHEDULE",
      "title": "扫描计划",
      "reason": "默认 @every 1h，每小时扫描；可使用 Cron 表达式，关闭定时扫描时填 0。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.navidrome",
      "title": "文件权限",
      "reason": "基础配置使用镜像默认用户；需要指定 UID/GID 时添加 user，并确保该用户能读写 ./data。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "navidrome",
      "name": "Navidrome",
      "developer": "Navidrome",
      "projectUrl": "https://github.com/navidrome/navidrome",
      "icon": "icons/navidrome.svg",
      "services": [
        "navidrome"
      ]
    }
  ],
