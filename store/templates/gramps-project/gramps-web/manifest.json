{
  "schemaVersion": 1,
  "id": "gramps-project/gramps-web",
  "kind": "compose",
  "name": "Gramps Web",
  "description": "整理家谱中的人物、亲属关系、事件与照片，在浏览器中共同维护家庭历史，并可与 Gramps 桌面端交换资料。",
  "developer": "gramps-project",
  "projectUrl": "https://github.com/gramps-project/gramps-web",
  "source": "open",
  "license": "AGPL-3.0",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "gramps-web",
    "家谱",
    "家庭历史"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/gramps-web.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://www.grampsweb.org/install_setup/deployment/",
  "applications": [
    {
      "id": "gramps-web",
      "name": "Gramps Web",
      "developer": "gramps-project",
      "projectUrl": "https://github.com/gramps-project/gramps-web",
      "icon": "icons/gramps-web.svg",
      "services": [
        "app",
        "worker"
      ]
    },
    {
      "id": "broker",
      "name": "Valkey",
      "developer": "Valkey",
      "projectUrl": "https://github.com/valkey-io/valkey",
      "icon": "icons/infra-valkey.svg",
      "services": [
        "redis"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.PUBLIC_URL",
      "title": "完整访问地址",
      "reason": "填写实际使用的完整地址，生成通知和邮件链接时使用。默认宿主机端口 80，可通过 HTTP_PORT 修改。",
      "required": true,
      "example": "http://nas.example.com"
    },
    {
      "target": "compose.services.app",
      "title": "首次设置",
      "reason": "初次访问按向导创建家谱拥有者账号，随后创建或导入家谱。后台任务服务与网页服务使用同一版本镜像和同一组资料目录。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.app.volumes",
      "title": "家谱资料与密钥",
      "reason": "人物数据库、账号、照片、索引和实例密钥分别持久化。请整体保留这些目录，尤其不要删除 ./secret 后继续沿用其他数据。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.worker",
      "title": "后台任务",
      "reason": "导入、导出和媒体处理由 worker 执行；不要只启动网页服务。Valkey 不发布宿主机端口。",
      "required": false,
      "example": ""
    }
  ],
