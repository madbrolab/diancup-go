{
  "schemaVersion": 1,
  "id": "louislam/uptime-kuma",
  "kind": "container",
  "name": "Uptime Kuma",
  "description": "自托管服务可用性监控，支持 HTTP、TCP 等探测。",
  "developer": "Louis Lam",
  "projectUrl": "https://github.com/louislam/uptime-kuma",
  "source": "open",
  "license": "MIT",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "monitoring",
  "tags": [
    "uptime",
    "kuma",
    "监控"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/uptime-kuma.svg",
  "payload": "container.json",
  "env": "",
  "recommendations": [
    {
      "target": "ports.http.host",
      "title": "管理端口",
      "reason": "确认端口未占用。",
      "required": true,
      "example": "3001"
    },
    {
      "target": "volumes.data.host",
      "title": "监控数据目录",
      "reason": "使用独立目录，保存监控配置和历史数据。",
      "required": true,
      "example": "/appdata/uptime-kuma"
    }
  ],
  "documentation": "https://github.com/louislam/uptime-kuma/blob/master/compose.yaml"
}
