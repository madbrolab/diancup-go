  "recommendations": [
    {
      "target": "env.NASIP",
      "title": "NASIP",
      "reason": "模板已有默认值，可按实际环境调整。",
      "required": false,
      "example": "修改成你NAS IP"
    },
    {
      "target": "compose.services.beidou-server.ports",
      "title": "beidou-server 端口映射",
      "reason": "请确认所选端口在目标服务器上可用。",
      "required": false,
      "example": "8484:8484、7575:7575、7576:7576、7577:7577"
    },
    {
      "target": "compose.services.beidou-server.volumes",
      "title": "beidou-server 数据与系统挂载",
      "reason": "相对路径以项目目录为基准，宿主机绝对路径可独立修改。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.beidou-ui.ports",
      "title": "beidou-ui 端口映射",
      "reason": "请确认所选端口在目标服务器上可用。",
      "required": false,
      "example": "8686:8686"
    },
    {
      "target": "compose.services.beidou-db.volumes",
      "title": "beidou-db 数据与系统挂载",
      "reason": "相对路径以项目目录为基准，宿主机绝对路径可独立修改。",
      "required": false,
      "example": ""
    }
