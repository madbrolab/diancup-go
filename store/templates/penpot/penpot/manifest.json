{
  "schemaVersion": 1,
  "id": "penpot/penpot",
  "kind": "compose",
  "name": "Penpot",
  "description": "在浏览器里协作设计界面、制作交互原型和维护设计系统，可与开发流程配合使用。项目提供可自建的开源版本和付费企业方案。",
  "developer": "penpot",
  "projectUrl": "https://github.com/penpot/penpot",
  "source": "open",
  "license": "MPL-2.0",
  "paidKey": "optional",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "penpot",
    "Penpot",
    "tools",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/penpot.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://help.penpot.app/technical-guide/getting-started/docker/",
  "applications": [
    {
      "id": "penpot",
      "name": "Penpot",
      "developer": "penpot",
      "projectUrl": "https://github.com/penpot/penpot",
      "icon": "icons/penpot.svg",
      "services": [
        "penpot-frontend",
        "penpot-backend",
        "penpot-admin-console",
        "penpot-mcp",
        "penpot-exporter",
        "prepare"
      ]
    },
    {
      "id": "postgresql",
      "name": "PostgreSQL",
      "developer": "PostgreSQL Global Development Group",
      "projectUrl": "https://www.postgresql.org/",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "penpot-postgres"
      ]
    },
    {
      "id": "valkey",
      "name": "Valkey",
      "developer": "Valkey",
      "projectUrl": "https://github.com/valkey-io/valkey",
      "icon": "icons/infra-valkey.svg",
      "services": [
        "penpot-valkey"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.PUBLIC_URL",
      "title": "实际访问地址",
      "reason": "填写浏览器使用的完整服务器地址或域名，与 HTTP_PORT 保持一致。",
      "required": true,
      "example": "https://design.example.com"
    },
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "数据库仅用于当前项目，请设置独立密码。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.SECRET_KEY",
      "title": "实例密钥",
      "reason": "建议使用 64 字节随机数据生成 URL 安全的 Base64 密钥，并在后续更新时保持不变。",
      "required": true,
      "example": ""
    },
    {
      "target": "compose.services.penpot-backend.environment",
      "title": "注册和邮件",
      "reason": "基础配置允许注册并关闭邮件验证；需要邮件邀请或找回密码时，按官方文档添加自己的 SMTP 配置。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.penpot-frontend.environment",
      "title": "访问协议",
      "reason": "默认适用于 HTTP 本地访问；使用 HTTPS 时按官方文档调整 secure-session-cookies 标志。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.prepare.volumes",
      "title": "设计资源目录",
      "reason": "./assets 保存设计资源，准备服务设置此目录属主供应用读写。",
      "required": false,
      "example": ""
    }
  ],
