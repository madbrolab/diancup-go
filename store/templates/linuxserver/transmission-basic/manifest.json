{
  "schemaVersion": 1,
  "id": "linuxserver/transmission-basic",
  "kind": "compose",
  "name": "Transmission 基础版",
  "description": "提供网页和 RPC 入口的 BitTorrent 下载服务，可管理下载、做种及自动监视目录。模板采用 LinuxServer.io 镜像。",
  "developer": "Transmission / LinuxServer.io",
  "projectUrl": "https://github.com/transmission/transmission",
  "source": "open",
  "license": "GPL-2.0-or-later",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "download",
  "tags": [
    "transmission",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/transmission.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.linuxserver.io/images/docker-transmission/",
  "recommendations": [
    {
      "target": "env.RPC_PASSWORD",
      "title": "管理界面密码",
      "reason": "部署前为当前实例填写独立密码，用户名默认 admin。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.DOWNLOADS_DIR",
      "title": "下载目录",
      "reason": "默认 ./downloads；与其他应用共享时保持宿主机目录及容器内 /downloads 路径一致。",
      "required": false,
      "example": ""
    },
    {
      "target": "env.PUID",
      "title": "文件属主",
      "reason": "PUID/PGID 默认 1000，请按下载目录权限调整。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "transmission",
      "name": "Transmission",
      "developer": "Transmission / LinuxServer.io",
      "projectUrl": "https://github.com/transmission/transmission",
      "icon": "icons/transmission.svg",
      "services": [
        "transmission"
      ]
    }
  ],
