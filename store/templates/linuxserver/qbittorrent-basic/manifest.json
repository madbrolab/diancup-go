{
  "schemaVersion": 1,
  "id": "linuxserver/qbittorrent-basic",
  "kind": "compose",
  "name": "qBittorrent 基础版",
  "description": "通过网页管理 BitTorrent 下载任务、队列与做种。此模板采用 LinuxServer.io 镜像，分别持久化设置和下载文件。",
  "developer": "qBittorrent / LinuxServer.io",
  "projectUrl": "https://github.com/qbittorrent/qBittorrent",
  "source": "open",
  "license": "GPL-2.0-or-later",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "download",
  "tags": [
    "qbittorrent",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/qbittorrent.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.linuxserver.io/images/docker-qbittorrent/",
  "recommendations": [
    {
      "target": "env.DOWNLOADS_DIR",
      "title": "下载目录",
      "reason": "默认 ./downloads；与 MoviePilot 共享时选择同一个宿主机目录，保持容器内路径 /downloads 一致。",
      "required": false,
      "example": ""
    },
    {
      "target": "env.PUID",
      "title": "文件属主",
      "reason": "PUID/PGID 默认 1000；请填写有权限访问下载目录的实际 UID/GID。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.qbittorrent",
      "title": "首次登录",
      "reason": "用户名 admin；首次临时密码从容器日志获取，登录后修改密码。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "qbittorrent",
      "name": "qBittorrent",
      "developer": "qBittorrent / LinuxServer.io",
      "projectUrl": "https://github.com/qbittorrent/qBittorrent",
      "icon": "icons/qbittorrent.svg",
      "services": [
        "qbittorrent"
      ]
    }
  ],
