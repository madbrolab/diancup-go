{
  "schemaVersion": 1,
  "id": "rommapp/romm",
  "kind": "compose",
  "name": "RomM",
  "description": "为自己的游戏 ROM 建立带封面和元数据的资料库，支持网页游玩、存档与状态管理，并可对接多种游戏资料服务。",
  "developer": "rommapp",
  "projectUrl": "https://github.com/rommapp/romm",
  "source": "open",
  "license": "AGPL-3.0",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "games",
  "tags": [
    "romm",
    "RomM",
    "games",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/romm.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.romm.app/",
  "applications": [
    {
      "id": "romm",
      "name": "RomM",
      "developer": "rommapp",
      "projectUrl": "https://github.com/rommapp/romm",
      "icon": "icons/romm.svg",
      "services": [
        "romm"
      ]
    },
    {
      "id": "mariadb",
      "name": "MariaDB",
      "developer": "MariaDB",
      "projectUrl": "https://github.com/MariaDB/server",
      "icon": "icons/infra-mariadb.svg",
      "services": [
        "romm-db"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.DB_PASSWORD",
      "title": "应用数据库密码",
      "reason": "为 RomM 数据库账号设置独立密码。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.DB_ROOT_PASSWORD",
      "title": "数据库管理密码",
      "reason": "为 MariaDB 管理账号设置不同的独立密码。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.AUTH_SECRET",
      "title": "会话密钥",
      "reason": "填写至少 64 位随机十六进制字符，并在后续更新时保持不变。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.LIBRARY_DIR",
      "title": "游戏资料库",
      "reason": "按应用文档组织自己的平台与 ROM 目录；存档保存在 ./assets，封面等资料保存在 ./resources。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.romm.environment",
      "title": "游戏元数据",
      "reason": "默认启用无需密钥的 Hasheous；其他资料服务的账号和 API 密钥在使用时按官方说明添加。",
      "required": false,
      "example": ""
    }
  ],
