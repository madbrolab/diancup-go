{
  "schemaVersion": 1,
  "id": "c4illin/convertx",
  "kind": "container",
  "name": "ConvertX",
  "description": "通过网页提交图片、文档、音频等文件，在 NAS 上选择目标格式并批量转换，减少在各台电脑重复安装转换软件的需要。",
  "developer": "C4illin",
  "projectUrl": "https://github.com/C4illin/ConvertX",
  "source": "open",
  "license": "AGPL-3.0",
  "paidKey": "unknown",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "convertx",
    "文件转换",
    "格式转换"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/convertx.svg",
  "payload": "container.json",
  "env": "",
  "documentation": "https://github.com/C4illin/ConvertX#usage",
  "recommendations": [
    {
      "target": "environment.JWT_SECRET",
      "title": "登录签名密钥",
      "reason": "填写至少 32 字符的随机值并长期保留。首次访问创建自己的账号，此后默认关闭公开注册。",
      "required": true,
      "example": ""
    },
    {
      "target": "environment.HTTP_ALLOWED",
      "title": "内网访问协议",
      "reason": "默认 true 允许内网 HTTP 登录；使用 HTTPS 反向代理时可按官方说明改为 false。",
      "required": false,
      "example": ""
    },
    {
      "target": "volumes.data.host",
      "title": "转换数据目录",
      "reason": "选择实例独立目录，保存账号及转换数据；镜像会按 PUID/PGID 修正目录权限。转换结果会按应用策略定期清理，重要文件请及时下载。",
      "required": true,
      "example": ""
    },
    {
      "target": "environment.LANGUAGE",
      "title": "日期显示",
      "reason": "zh-CN 控制日期格式，不代表全部界面已汉化。",
      "required": false,
      "example": ""
    },
    {
      "target": "image",
      "title": "收费状态",
      "reason": "README 未明确收费服务或付费激活要求；各格式的转换能力取决于镜像内置工具及文件本身。",
      "required": false,
      "example": ""
    }
  ],
