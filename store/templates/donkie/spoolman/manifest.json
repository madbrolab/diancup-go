{
  "schemaVersion": 1,
  "id": "donkie/spoolman",
  "kind": "compose",
  "name": "Spoolman",
  "description": "记录 3D 打印耗材的品牌、材质、颜色和剩余重量，打印前查找合适料卷，并可连接兼容打印软件同步耗材用量。",
  "developer": "Donkie",
  "projectUrl": "https://github.com/Donkie/Spoolman",
  "source": "open",
  "license": "MIT",
  "paidKey": "unknown",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "spoolman",
    "3D打印",
    "耗材"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/spoolman.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/Donkie/Spoolman/wiki/Installation",
  "applications": [
    {
      "id": "spoolman",
      "name": "Spoolman",
      "developer": "Donkie",
      "projectUrl": "https://github.com/Donkie/Spoolman",
      "icon": "icons/spoolman.svg",
      "services": [
        "prepare",
        "app"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.PUID",
      "title": "运行用户",
      "reason": "填写正整数 UID，不能为 0；与 PGID 一起对应资料目录的实际读写用户。准备任务只修改目录本身，已有文件仍须能被该用户读写。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.app.volumes",
      "title": "耗材数据库",
      "reason": "默认使用 SQLite，数据库和相关数据保存在 ./data；无须单独部署数据库服务。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.app.ports",
      "title": "网页与打印软件",
      "reason": "默认入口 7912。应用不提供账号认证，适合受控内网使用；打印软件对接时填写其实际可访问的地址。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.app.image",
      "title": "收费状态",
      "reason": "项目使用 MIT 许可；README 未明确收费服务或付费激活要求，收费状态保留为未知。",
      "required": false,
      "example": ""
    }
  ],
