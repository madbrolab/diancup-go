{
  "schemaVersion": 1,
  "id": "official/nginx",
  "kind": "container",
  "name": "Nginx",
  "description": "轻量 Web 服务与反向代理，网站目录以只读方式挂载。",
  "developer": "NGINX",
  "projectUrl": "https://github.com/nginx/nginx",
  "source": "open",
  "license": "BSD-2-Clause",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "web",
  "tags": [
    "nginx",
    "网站",
    "反向代理"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/nginx.svg",
  "payload": "container.json",
  "env": "",
  "recommendations": [
    {
      "target": "ports.http.host",
      "title": "访问端口",
      "reason": "按实际情况设置宿主机端口。",
      "required": true,
      "example": "8080"
    },
    {
      "target": "volumes.html.host",
      "title": "网站目录",
      "reason": "选择已有网站文件目录，只读挂载。",
      "required": true,
      "example": "/appdata/nginx/html"
    }
  ],
  "documentation": "https://hub.docker.com/_/nginx"
}
