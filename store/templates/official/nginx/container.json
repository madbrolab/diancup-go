{
  "name": "nginx",
  "image": "nginx:stable-alpine",
  "ports": [
    {
      "id": "http",
      "host": "8080",
      "container": "80"
    }
  ],
  "volumes": [
    {
      "id": "html",
      "host": "/appdata/nginx/html",
      "container": "/usr/share/nginx/html",
      "mode": "ro"
    }
  ],
  "environment": [],
  "restart_policy": "unless-stopped",
  "network_mode": "bridge",
  "privileged": false,
  "labels": {},
  "command": [],
  "cpu_limit": "",
  "memory_limit": ""
}
