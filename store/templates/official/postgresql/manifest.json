{
  "schemaVersion": 1,
  "id": "official/postgresql",
  "kind": "container",
  "name": "PostgreSQL",
  "description": "关系型数据库，默认仅在本机回环地址暴露端口。",
  "developer": "PostgreSQL",
  "projectUrl": "https://github.com/postgres/postgres",
  "source": "open",
  "license": "PostgreSQL",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "database",
  "tags": [
    "postgres",
    "postgresql",
    "数据库"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/postgresql.svg",
  "payload": "container.json",
  "env": "",
  "recommendations": [
    {
      "target": "volumes.data.host",
      "title": "数据库目录",
      "reason": "必须使用独立目录；已有其他版本数据不能直接混用。",
      "required": true,
      "example": "/appdata/postgresql"
    },
    {
      "target": "environment.POSTGRES_PASSWORD",
      "title": "数据库密码",
      "reason": "填写足够强的独立密码。",
      "required": true,
      "example": ""
    },
    {
      "target": "ports.http.host",
      "title": "数据库监听地址",
      "reason": "默认仅本机可连接，按需调整。",
      "required": true,
      "example": "127.0.0.1:5432"
    }
  ],
  "documentation": "https://hub.docker.com/_/postgres"
}
