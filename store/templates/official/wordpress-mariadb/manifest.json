{
  "schemaVersion": 1,
  "id": "official/wordpress-mariadb",
  "kind": "compose",
  "name": "WordPress + MariaDB",
  "description": "博客网站和独立数据库，数据库仅在项目网络中访问。",
  "developer": "WordPress / MariaDB",
  "projectUrl": "https://github.com/WordPress/WordPress",
  "source": "open",
  "license": "GPL-2.0-or-later",
  "paidKey": "none",
  "version": "1.1.1",
  "category": "web",
  "tags": [
    "wordpress",
    "mariadb",
    "博客",
    "网站"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/wordpress-mariadb.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "recommendations": [
    {
      "target": "env.WEB_PORT",
      "title": "网站端口",
      "reason": "确认宿主机端口可用。",
      "required": true,
      "example": "8080"
    },
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "网站与数据库使用同一个非空密码。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.DB_ROOT_PASSWORD",
      "title": "数据库管理员密码",
      "reason": "使用与网站数据库密码不同的强密码。",
      "required": true,
      "example": ""
    }
  ],
  "documentation": "https://hub.docker.com/_/wordpress",
  "applications": [
    {
      "id": "wordpress",
      "name": "WordPress",
      "icon": "icons/wordpress.svg",
      "developer": "WordPress",
      "projectUrl": "https://github.com/WordPress/WordPress",
      "services": [
        "wordpress"
      ]
    },
    {
      "id": "mariadb",
      "name": "MariaDB",
      "icon": "icons/mariadb.svg",
      "developer": "MariaDB",
      "projectUrl": "https://github.com/MariaDB/server",
      "services": [
        "db"
      ]
    }
  ],
