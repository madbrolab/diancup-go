{
  "schemaVersion": 1,
  "id": "immich-app/immich",
  "kind": "compose",
  "name": "Immich",
  "description": "备份和浏览自己的照片、视频，支持手机上传、相册分享、地图与人物检索；模板包含 CPU 机器学习服务和配套数据库。",
  "developer": "immich-app",
  "projectUrl": "https://github.com/immich-app/immich",
  "source": "open",
  "license": "AGPL-3.0",
  "paidKey": "unknown",
  "version": "1.0.0",
  "category": "media",
  "tags": [
    "immich",
    "Immich",
    "media",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/immich.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.immich.app/install/docker-compose/",
  "applications": [
    {
      "id": "immich",
      "name": "Immich",
      "developer": "immich-app",
      "projectUrl": "https://github.com/immich-app/immich",
      "icon": "icons/immich.svg",
      "services": [
        "immich-server",
        "immich-machine-learning"
      ]
    },
    {
      "id": "valkey",
      "name": "Valkey",
      "developer": "Valkey",
      "projectUrl": "https://github.com/valkey-io/valkey",
      "icon": "icons/infra-valkey.svg",
      "services": [
        "redis"
      ]
    },
    {
      "id": "postgresql",
      "name": "PostgreSQL",
      "developer": "PostgreSQL Global Development Group",
      "projectUrl": "https://www.postgresql.org/",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "database"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "为新实例填写独立密码，数据库仅在项目网络内提供服务。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.LIBRARY_DIR",
      "title": "相册存储目录",
      "reason": "新上传的原始照片、缩略图和转码文件保存在此目录；数据库 ./postgres 必须位于支持所需文件系统操作的本地磁盘。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.immich-machine-learning",
      "title": "照片检索模型",
      "reason": "默认使用 CPU 机器学习；首次运行需下载模型，为相册索引和检索预留内存。",
      "required": false,
      "example": ""
    },
    {
      "target": "env.IMMICH_VERSION",
      "title": "应用版本",
      "reason": "默认使用已发布的 v3.3.5；应用、机器学习和数据库扩展的兼容性应按对应版本说明确认。",
      "required": false,
      "example": ""
    }
  ],
