  "env": "env.example",
  "documentation": "https://www.home-assistant.io/installation/linux#install-home-assistant-container",
  "applications": [
    {
      "id": "home-assistant",
      "name": "Home Assistant",
      "developer": "home-assistant",
      "projectUrl": "https://github.com/home-assistant/core",
      "icon": "icons/home-assistant.svg",
      "services": [
        "home-assistant"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "compose.services.home-assistant.network_mode",
      "title": "家庭设备发现",
      "reason": "使用官方 Container 部署方式及 Host 网络，默认入口为宿主机 8123；首次访问创建家庭和管理员账号。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.home-assistant.volumes",
      "title": "设备与蓝牙",
      "reason": "D-Bus 挂载用于蓝牙；宿主机没有该服务且不使用蓝牙时可移除此行。USB 网关等设备按实际硬件另行配置。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.home-assistant",
      "title": "安装类型",
      "reason": "Container 版不包含 Supervisor 和应用商店；相关配套服务需独立部署，家庭自动化配置保存在 ./config。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.home-assistant.privileged",
      "title": "硬件访问",
      "reason": "保留官方示例的特权模式以支持硬件接入，可按实际集成需求进一步收紧。",
      "required": false,
      "example": ""
    }
  ],
