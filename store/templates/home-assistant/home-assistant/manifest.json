  "id": "home-assistant/home-assistant",
  "kind": "compose",
  "name": "Home Assistant",
  "description": "连接家中的智能设备、传感器与服务，建立自动化场景和家庭仪表盘。此模板部署 Home Assistant Container，配置保存在自己的 NAS。",
  "developer": "home-assistant",
  "projectUrl": "https://github.com/home-assistant/core",
