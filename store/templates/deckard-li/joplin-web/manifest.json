{
  "schemaVersion": 1,
  "id": "deckard-li/joplin-web",
  "kind": "compose",
  "name": "Joplin Web 网页笔记",
  "description": "在浏览器中用中文编辑 Markdown 笔记，通过卡片或列表浏览笔记本，并与已有的 Joplin Server 同步。支持手机和电脑。",
  "developer": "Deckard-Li",
  "projectUrl": "https://github.com/Deckard-Li/joplin-self-hosted-web",
  "source": "open",
  "license": "AGPL-3.0-or-later",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "Joplin",
    "网页笔记",
    "Markdown",
    "同步",
    "中文"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/joplin-web.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/Deckard-Li/joplin-self-hosted-web/blob/b6a71a78a2c405143648e8ed960548cc6889d122/README.md#configure-synchronisation",
  "recommendations": [
    {
      "target": "env.JOPLIN_SERVER_URL",
      "title": "已有 Joplin Server 的地址",
      "reason": "填写容器能访问的同步后端完整地址，保留协议、端口和已有路径前缀。首次安装需要从 GitHub 获取指定版本的网页端文件。",
      "required": true,
      "example": "https://sync.example.com"
    },
    {
      "target": "env.WEB_HOST",
      "title": "网页端的访问主机",
      "reason": "填写浏览器访问网页端时使用的局域网 IP 或域名。HTTPS 证书按此名称签发，端口在 HTTPS_PORT 中设置。",
      "required": true,
      "example": "notes.home.arpa"
    },
    {
      "target": "env.HTTPS_PORT",
      "title": "首次打开 HTTPS 网页",
      "reason": "默认端口为 8443。将项目目录下的 https/data/caddy/pki/authorities/local/root.crt 导入客户端受信任根证书后，打开 https://访问主机:端口。只需分发 root.crt。",
      "required": false,
      "example": "8443"
    },
    {
      "target": "compose.services.web",
      "title": "连接现有笔记",
      "reason": "在网页的「配置 → 同步」中选择 Joplin Server。同步地址填网页访问地址加 /joplin，再输入已有账号的邮箱和密码。",
      "required": false,
      "example": "https://notes.home.arpa:8443/joplin"
    }
  ],
  "applications": [
    {
      "id": "joplin-web",
      "name": "Joplin Web",
      "developer": "Deckard-Li",
      "projectUrl": "https://github.com/Deckard-Li/joplin-self-hosted-web",
      "icon": "icons/joplin-web.svg",
      "services": [
        "assets",
        "web",
        "https"
      ]
    }
  ],
