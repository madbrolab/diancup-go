{
  "schemaVersion": 1,
  "id": "madbrolab/dian115-basic",
  "kind": "compose",
  "name": "DIAN115 + PostgreSQL 基础版",
  "description": "管理 115 网盘资源、媒体整理、STRM 与影音服务接入。主程序采用私有授权，需要激活密钥；此基础配置配套 PostgreSQL 18。",
  "developer": "madbrolab",
  "projectUrl": "https://github.com/madbrolab/dian115",
  "source": "closed",
  "license": "Proprietary / private activation license",
  "paidKey": "required",
  "version": "1.0.1",
  "category": "media",
  "tags": [
    "dian115",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/basic-dian115.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://madbrolab.github.io/dian115/docs/database-postgresql/",
  "recommendations": [
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "同一密码同时用于数据库和连接串；仅使用字母、数字、下划线或连字符，建议至少 32 位随机十六进制字符。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.MEDIA_DIR",
      "title": "媒体目录",
      "reason": "默认 ./media，可选择已有媒体或 STRM 目录；与 Emby 的容器内路径保持一致。",
      "required": false,
      "example": ""
    },
    {
      "target": "env.CLOUD_MOUNT_DIR",
      "title": "云盘挂载目录",
      "reason": "默认 ./cloud；接入 CloudDrive2 时改为它实际发布挂载的宿主机目录，使用 rslave 接收挂载。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.dian115",
      "title": "按需启用宿主机集成",
      "reason": "基础配置无需显卡设备；使用 DianCupLite 容器管理时再添加 Docker socket 挂载。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.dian115.network_mode",
      "title": "Host 网络",
      "reason": "适用于 Linux；后台端口默认 8095，Emby 代理和音乐端口在应用内配置，避免与已有服务冲突。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.postgres.volumes",
      "title": "PostgreSQL 18 数据目录",
      "reason": "新装数据保存在 ./postgres，挂载至 /var/lib/postgresql；已有 PG16 数据需要先迁移，不能仅修改镜像复用原目录。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "dian115",
      "name": "DIAN115",
      "developer": "madbrolab",
      "projectUrl": "https://github.com/madbrolab/dian115",
      "icon": "icons/basic-dian115.svg",
      "services": [
        "dian115"
      ]
    },
    {
