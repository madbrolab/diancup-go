{
  "schemaVersion": 1,
  "id": "jeffvli/feishin",
  "kind": "compose",
  "name": "Feishin",
  "description": "为已有 Navidrome、Jellyfin 或 Subsonic 音乐服务提供网页播放器，支持歌词、收藏与播放列表；音乐文件由所连接的服务管理。",
  "developer": "jeffvli",
  "projectUrl": "https://github.com/jeffvli/feishin",
  "source": "open",
  "license": "GPL-3.0",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "media",
  "tags": [
    "feishin",
    "Feishin",
    "media",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/feishin.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/jeffvli/feishin/blob/development/README.md",
  "applications": [
    {
      "id": "feishin",
      "name": "Feishin",
      "developer": "jeffvli",
      "projectUrl": "https://github.com/jeffvli/feishin",
      "icon": "icons/feishin.svg",
      "services": [
        "feishin"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.SERVER_URL",
      "title": "音乐服务地址",
      "reason": "可预设服务地址，也可在首次打开播放器时添加；该地址必须能从用户的浏览器访问。",
      "required": false,
      "example": "http://music.example.com:4533"
    },
    {
      "target": "env.SERVER_TYPE",
      "title": "音乐服务类型",
      "reason": "可选 navidrome、jellyfin 或 subsonic；使用对应服务的账号登录。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.feishin",
      "title": "播放器设置",
      "reason": "播放器设置保存在浏览器中；此模板提供网页播放，不包含桌面版 MPV 后端。",
      "required": false,
      "example": ""
    }
  ],
