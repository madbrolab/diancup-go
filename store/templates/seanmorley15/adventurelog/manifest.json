{
  "schemaVersion": 1,
  "id": "seanmorley15/adventurelog",
  "kind": "compose",
  "name": "AdventureLog",
  "description": "在地图上记录旅行足迹、照片和经历，整理想去的地点与行程计划，把个人旅行资料持续保存在自己的服务器。",
  "developer": "seanmorley15",
  "projectUrl": "https://github.com/seanmorley15/AdventureLog",
  "source": "open",
  "license": "GPL-3.0",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "adventurelog",
    "旅行",
    "地图",
    "行程"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/adventurelog.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/seanmorley15/AdventureLog#readme",
  "applications": [
    {
      "id": "adventurelog",
      "name": "AdventureLog",
      "developer": "seanmorley15",
      "projectUrl": "https://github.com/seanmorley15/AdventureLog",
      "icon": "icons/adventurelog.svg",
      "services": [
        "app"
      ]
    },
    {
      "id": "database",
      "name": "PostgreSQL + PostGIS",
      "developer": "PostgreSQL / PostGIS / imresamu",
      "projectUrl": "https://github.com/imresamu/docker-postgis",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "db"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.SITE_URL",
      "title": "实际访问地址",
      "reason": "填写包含协议和端口的真实访问地址，与 HTTP_PORT 或反向代理地址一致。",
      "required": true,
      "example": "http://nas.example.com:8015"
    },
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "填写独立密码，应用与 PostGIS 使用同一值。",
      "required": true,
      "example": ""
    },
    {
      "target": "compose.services.app",
      "title": "首次启动与登录",
      "reason": "首次启动会导入地理资料，耗时及内存占用较高；等待初始化完成后，以 admin / admin 登录并立即修改密码。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.db.image",
      "title": "地图数据库",
      "reason": "采用官方文档列出的 ARM 兼容 PostGIS 16 镜像，同时支持 amd64 和 arm64。./postgres 保存数据库，./media 保存上传照片，均需保留。",
      "required": false,
      "example": ""
    }
  ],
  "verification": {
