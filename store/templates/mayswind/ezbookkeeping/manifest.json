{
  "schemaVersion": 1,
  "id": "mayswind/ezbookkeeping",
  "kind": "compose",
  "name": "ezBookkeeping",
  "description": "记录个人收支与账户往来，按分类、币种和时间查看账目统计；搭配独立 PostgreSQL，适合长期维护家庭财务记录。",
  "developer": "mayswind",
  "projectUrl": "https://github.com/mayswind/ezbookkeeping",
  "source": "open",
  "license": "MIT",
  "paidKey": "unknown",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "ezbookkeeping",
    "记账",
    "财务"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/ezbookkeeping.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://ezbookkeeping.mayswind.net/installation/installation-docker",
  "applications": [
    {
      "id": "ezbookkeeping",
      "name": "ezBookkeeping",
      "developer": "mayswind",
      "projectUrl": "https://github.com/mayswind/ezbookkeeping",
      "icon": "icons/ezbookkeeping.svg",
      "services": [
        "prepare",
        "app"
      ]
    },
    {
      "id": "database",
      "name": "PostgreSQL",
      "developer": "PostgreSQL",
      "projectUrl": "https://www.postgresql.org/",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "db"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.PUBLIC_DOMAIN",
      "title": "访问域名或 IP",
      "reason": "仅填写实际域名或 IP，不带协议、端口和路径。",
      "required": true,
      "example": "nas.example.com"
    },
    {
      "target": "env.PUBLIC_URL",
      "title": "完整访问地址",
      "reason": "填写浏览器实际使用的完整地址，与 HTTP_PORT 或反向代理地址保持一致。首次进入页面注册账号。",
      "required": true,
      "example": "http://nas.example.com:8080/"
    },
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "填写独立密码，应用与 PostgreSQL 使用同一值；数据库不发布宿主机端口。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.SECRET_KEY",
      "title": "实例密钥",
      "reason": "填写至少 32 字符的独立随机值并长期保留。",
      "required": true,
      "example": ""
    },
    {
      "target": "compose.services.prepare",
      "title": "文件目录权限",
      "reason": "日志与附件目录初始化为 UID/GID 1000，仅调整目录本身。./postgres、./storage 均须长期保留，复用已有目录时确认内部文件权限。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.app.image",
      "title": "正式使用配置",
      "reason": "采用官方建议的外部数据库方案；项目 README 未明确收费服务或激活要求，收费状态保留为未知。",
      "required": false,
      "example": ""
    }
  ],
