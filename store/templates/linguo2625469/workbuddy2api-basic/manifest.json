{
  "schemaVersion": 1,
  "id": "linguo2625469/workbuddy2api-basic",
  "kind": "compose",
  "name": "WorkBuddy2API Panel 基础版",
  "description": "为自己的 WorkBuddy 账号提供 OpenAI 兼容接口及网页管理入口，可管理账号状态、任务与接口配置。项目本身免费，上游服务按对应账号规则使用。",
  "developer": "linguo2625469",
  "projectUrl": "https://github.com/linguo2625469/workbuddy2api-panel",
  "source": "open",
  "license": "MIT",
  "paidKey": "none",
  "version": "1.0.0",
  "category": "ai",
  "tags": [
    "workbuddy2api",
    "基础模板",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/basic-workbuddy2api.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://github.com/linguo2625469/workbuddy2api-panel/blob/main/README.md",
  "recommendations": [
    {
      "target": "env.API_KEY",
      "title": "API 访问密钥",
      "reason": "为当前实例设置独立的访问密钥。",
      "required": true,
      "example": ""
    },
    {
      "target": "env.PUID",
      "title": "数据目录用户",
      "reason": "默认 UID/GID 均为 10001；prepare 会初始化并调整本项目 config、auths、data 的属主。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.wb2api",
      "title": "首次使用",
      "reason": "启动后在面板登录自己的上游账号；尚未加入可用账号时 /healthz 返回 503 属于未就绪状态。",
      "required": false,
      "example": ""
    }
  ],
  "applications": [
    {
      "id": "workbuddy2api",
      "name": "WorkBuddy2API Panel",
      "developer": "linguo2625469",
      "projectUrl": "https://github.com/linguo2625469/workbuddy2api-panel",
      "icon": "icons/basic-workbuddy2api.svg",
      "services": [
        "prepare",
        "wb2api"
      ]
    }
  ],
