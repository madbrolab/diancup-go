{
  "schemaVersion": 1,
  "id": "toeverything/affine",
  "kind": "compose",
  "name": "AFFiNE",
  "description": "把文档、白板和知识组织放在同一个协作工作区，支持自由排版与多人编辑。社区版可免费自建，其他版本和云端服务另有方案。",
  "developer": "toeverything",
  "projectUrl": "https://github.com/toeverything/AFFiNE",
  "source": "open",
  "license": "MIT (Community Edition); separate terms for other editions",
  "paidKey": "optional",
  "version": "1.0.0",
  "category": "tools",
  "tags": [
    "affine",
    "AFFiNE",
    "tools",
    "compose"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "icon": "icons/affine.svg",
  "payload": "compose.yaml",
  "env": "env.example",
  "documentation": "https://docs.affine.pro/self-host-affine",
  "applications": [
    {
      "id": "affine",
      "name": "AFFiNE",
      "developer": "toeverything",
      "projectUrl": "https://github.com/toeverything/AFFiNE",
      "icon": "icons/affine.svg",
      "services": [
        "affine",
        "affine_migration"
      ]
    },
    {
      "id": "postgresql",
      "name": "PostgreSQL",
      "developer": "PostgreSQL Global Development Group",
      "projectUrl": "https://www.postgresql.org/",
      "icon": "icons/infra-postgresql.svg",
      "services": [
        "postgres"
      ]
    },
    {
      "id": "redis",
      "name": "Redis",
      "developer": "Redis",
      "projectUrl": "https://github.com/redis/redis",
      "icon": "icons/infra-redis.svg",
      "services": [
        "redis"
      ]
    }
  ],
  "recommendations": [
    {
      "target": "env.DB_PASSWORD",
      "title": "数据库密码",
      "reason": "连接 URL 使用此密码，建议填写至少 32 位随机十六进制字符，避免 URL 特殊字符。",
      "required": true,
      "example": ""
    },
    {
      "target": "compose.services.affine",
      "title": "首次配置",
      "reason": "准备任务成功后启动工作区，首次访问完成管理员和站点地址设置。",
      "required": false,
      "example": ""
    },
    {
      "target": "compose.services.affine.volumes",
      "title": "工作区数据",
      "reason": "./storage 保存上传内容，./config 保存实例配置，./postgres 保存数据库；需一并保留。",
      "required": false,
      "example": ""
    }
  ],
